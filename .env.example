# Copy to .env for local use. Never commit real credentials.
DATABASE_URL=sqlite:///./gateway.db
ADMIN_API_KEY=replace-with-a-long-random-secret

# OpenAI-compatible provider endpoint, including /v1 or the provider's equivalent.
PRIMARY_BASE_URL=https://api.openai.com/v1
PRIMARY_API_KEY=replace-with-provider-key
ALLOWED_MODELS=gpt-4o-mini

# Optional one-provider fallback. Set all three values to enable it.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# Optional model pricing used for estimates (USD per 1M tokens).
# Example: {"gpt-4o-mini":{"input":0.15,"output":0.60}}
MODEL_PRICING_USD_PER_1M={}
PROVIDER_TIMEOUT_SECONDS=25
